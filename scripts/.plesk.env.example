# Config locale per scripts/deploy-plesk.sh — copia in scripts/.plesk.env (NON tracciato).
# I valori reali li fornisce il cliente/hosting Plesk.

WP_API_URL="https://cms.<dominio>/wp-json/edilmetal/v1"
SITE_URL="https://<dominio>"

PLESK_SFTP_HOST="<host-sftp-plesk>"
PLESK_SFTP_PORT="22"
PLESK_SFTP_USER="<utente-sftp>"
PLESK_SFTP_PASSWORD="<password-sftp>"

# Document root del dominio (o sottocartella per l'anteprima protetta da basic auth)
PLESK_REMOTE_PATH="httpdocs/"
